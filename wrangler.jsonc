{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "image-search-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "image-search-demo",
      "remote": true
    }
  ]
}
