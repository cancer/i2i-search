{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "i2i-search",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "i2i-search",
      "database_id": "ec75bd07-4c01-4ddb-9d44-1c4c5560e614",
      "remote": true
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "i2i-search",
      "remote": true
    }
  ]
}
