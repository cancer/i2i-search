{
  "name": "i2i-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:images": "node --experimental-strip-types scripts/generate-images.ts",
    "enrich:products": "node --experimental-strip-types scripts/enrich-products.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "dev:ui": "vite",
    "build": "vite build",
    "dev": "wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "generate-types": "wrangler types"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^22.10.0",
    "sharp": "^0.34.0",
    "svelte": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
